{
  "name": "youss-connect",
  "version": "2.0.0",
  "private": true,
  "description": "YOUSS CONNECT — maquette interactive de la super application africaine portée par KYA CORPORATION.",
  "scripts": {
    "build:css": "node node_modules/tailwindcss/lib/cli.js -i ./src/styles.css -o ./css/app.css --minify",
    "watch:css": "node node_modules/tailwindcss/lib/cli.js -i ./src/styles.css -o ./css/app.css --watch",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1",
    "dev": "npm run build:css && npm run serve"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.9",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "qrcode-generator": "1.4.4"
  }
}
